server {
    listen 80; listen [::]:80;
    server_name mcp.wenshucha.com;
    location ^~ /.well-known/ { root /www/wwwroot/default; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl; listen [::]:443 ssl; http2 on;
    server_name mcp.wenshucha.com;
    ssl_certificate     /etc/letsencrypt/live/tob.wenshucha.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tob.wenshucha.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /www/wwwroot/mcp; index index.html;

    location ^~ /.well-known/ { root /www/wwwroot/default; }
    location = /.gitignore { return 404; }
    location = /.vercelignore { return 404; }
    location = /trial-keys-private.md { return 404; }
    location ~* ^/trial-keys-.*\.md$ { return 404; }

    # ---- MCP 服务 API ----
    # 反向隧道 18303 -> Jack 本机 8848 -> localhost:9201 转发器 -> Mac mini ES
    # 宝塔有全局 proxy_cache，JSON-RPC 绝不能被缓存，必须显式关闭。
    location = /mcp {
        proxy_pass http://127.0.0.1:18303/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        client_max_body_size 2m;
    }
    location = /mcp/health {
        proxy_pass http://127.0.0.1:18303/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache off;
        proxy_read_timeout 15s;
    }

    location / { try_files $uri $uri.html $uri/index.html $uri/ =404; }
}
